# ===== Copiez ce fichier en « .env » SUR LE SERVEUR et remplissez-le. Ne le publiez jamais. =====
DOMAIN=hda-global.ma
ALLOWED_HOSTS=hda-global.ma,www.hda-global.ma
SITE_URL=https://hda-global.ma

# Générer :  python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=

POSTGRES_DB=hda_db
POSTGRES_USER=hda_user
POSTGRES_PASSWORD=

# Email (Gmail : mot de passe d'application du compte)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=hda.global82@gmail.com
EMAIL_HOST_PASSWORD=
HDA_EMAIL=hda.global82@gmail.com
HDA_PHONE=+212661103988

# Assistant IA
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free

# À activer (31536000) une fois que le HTTPS fonctionne correctement
SECURE_HSTS_SECONDS=0

SUIVI_VALIDITE_JOURS=90
SUIVI_LIMITE_PAR_MINUTE=60
